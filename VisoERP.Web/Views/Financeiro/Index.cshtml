@model VisoERP.Web.Models.Financeiro.FinanceiroViewModel
@{ ViewData["Title"] = "Financeiro"; var resumo = Model.Resumo!; }
<h1>Financeiro</h1>
@if (TempData["Erro"] is string erro) { <div class="alert alert-danger">@erro</div> }
<form method="get" class="row g-2 align-items-end mb-4">
    <div class="col-auto"><label for="inicio" class="form-label">De</label><input id="inicio" name="inicio" type="date" value="@Model.Inicio.ToString("yyyy-MM-dd")" class="form-control" /></div>
    <div class="col-auto"><label for="fim" class="form-label">Até</label><input id="fim" name="fim" type="date" value="@Model.Fim.ToString("yyyy-MM-dd")" class="form-control" /></div>
    <div class="col-auto"><button class="btn btn-primary" type="submit">Filtrar</button></div>
</form>
<div class="row g-3 mb-4 kpi-grid">
    <div class="col-12 col-sm-6 col-xl-3"><article class="kpi-card kpi-sales"><span class="kpi-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M7 9h.01M17 15h.01M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z"/></svg></span><span class="kpi-copy"><span>Vendas realizadas</span><strong>@resumo.Faturamento.ToString("C")</strong></span></article></div>
    <div class="col-12 col-sm-6 col-xl-3"><article class="kpi-card kpi-received"><span class="kpi-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3v18M17 7.5c0-1.4-1.9-2.5-4.5-2.5S8 6.1 8 7.5 9.9 10 12.5 10s4.5 1.1 4.5 2.5-1.9 2.5-4.5 2.5S8 13.9 8 12.5"/></svg></span><span class="kpi-copy"><span>Dinheiro recebido</span><strong>@resumo.Recebido.ToString("C")</strong></span></article></div>
    <div class="col-12 col-sm-6 col-xl-3"><article class="kpi-card kpi-purchases"><span class="kpi-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 4h2l2.2 11.2a2 2 0 0 0 2 1.6h8.7a2 2 0 0 0 1.9-1.4L22 8H6"/><circle cx="10" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg></span><span class="kpi-copy"><span>Compras de estoque</span><strong>@resumo.Compras.ToString("C")</strong></span></article></div>
    <div class="col-12 col-sm-6 col-xl-3"><article class="kpi-card kpi-cogs"><span class="kpi-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="M3 8v9l9 5 9-5V8M12 13v9"/></svg></span><span class="kpi-copy"><span>CPV histórico</span><strong>@resumo.CustoProdutosVendidos.ToString("C")</strong></span></article></div>
    <div class="col-12 col-sm-6 col-xl-3"><article class="kpi-card kpi-gross"><span class="kpi-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 17 9 11l4 4 8-9"/><path d="M15 6h6v6"/></svg></span><span class="kpi-copy"><span>Lucro bruto</span><strong>@resumo.LucroBruto.ToString("C")</strong></span></article></div>
    <div class="col-12 col-sm-6 col-xl-3"><article class="kpi-card kpi-expenses"><span class="kpi-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2V3Z"/><path d="M9 8h6M9 12h6M9 16h3"/></svg></span><span class="kpi-copy"><span>Despesas do período</span><strong>@resumo.Despesas.ToString("C")</strong></span></article></div>
    <div class="col-12 col-sm-6 col-xl-3"><article class="kpi-card kpi-net"><span class="kpi-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 18h18M5 15l4-5 4 3 6-8"/><path d="M15 5h4v4"/></svg></span><span class="kpi-copy"><span>Lucro líquido estimado</span><strong>@resumo.LucroLiquido.ToString("C")</strong></span></article></div>
    <div class="col-12 col-sm-6 col-xl-3"><article class="kpi-card kpi-roi"><span class="kpi-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8 16 8-8M9 8h.01M15 16h.01"/></svg></span><span class="kpi-copy"><span>ROI estimado</span><strong>@(resumo.RetornoSobreInvestimentoPercentual.HasValue ? resumo.RetornoSobreInvestimentoPercentual.Value.ToString("N2") + "%" : "—")</strong></span></article></div>
    <div class="col-12 col-sm-6 col-xl-3"><article class="kpi-card kpi-investment"><span class="kpi-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M15 9.5c0-1-1.3-1.7-3-1.7s-3 .7-3 1.7 1.3 1.7 3 1.7 3 .7 3 1.7-1.3 1.7-3 1.7-3-.7-3-1.7"/></svg></span><span class="kpi-copy"><span>Investido no período</span><strong>@resumo.InvestimentoPeriodo.ToString("C")</strong></span></article></div>
    <div class="col-12 col-sm-6 col-xl-3"><article class="kpi-card kpi-capital"><span class="kpi-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 21h18M5 21V8l7-5 7 5v13M9 21v-8h6v8M9 9h.01M15 9h.01"/></svg></span><span class="kpi-copy"><span>Capital investido até o fim</span><strong>@resumo.CapitalInvestidoAteFim.ToString("C")</strong></span></article></div>
    <div class="col-12 col-sm-6 col-xl-3"><article class="kpi-card kpi-receivable"><span class="kpi-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2M7 3 4 6M17 3l3 3"/></svg></span><span class="kpi-copy"><span>Contas a receber</span><strong>@resumo.ContasReceber.ToString("C")</strong></span></article></div>
    <div class="col-12 col-sm-6 col-xl-3"><article class="kpi-card kpi-payable"><span class="kpi-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 3h14v18l-3-2-4 2-4-2-3 2V3Z"/><path d="M9 8h6M9 12h6M9 16h3"/></svg></span><span class="kpi-copy"><span>Contas a pagar</span><strong>@resumo.ContasPagar.ToString("C")</strong></span></article></div>
</div>
<p class="text-muted">Lucro líquido estimado = vendas − custo histórico dos produtos vendidos − despesas por competência. Compras de estoque e investimentos são apresentados separadamente.</p>
<div class="row g-4 mb-4">
    <section class="col-md-6"><div class="card"><div class="card-body"><h2 class="h4">Registrar investimento</h2>
        <form asp-action="Investir" method="post" class="row g-2">
            <div class="col-12"><label class="form-label">Descrição</label><input name="Descricao" maxlength="200" required class="form-control" /></div>
            <div class="col-6"><label class="form-label">Valor</label><input name="Valor" type="text" inputmode="decimal" data-money-mask required class="form-control" /></div>
            <div class="col-6"><label class="form-label">Data</label><input name="Data" type="date" value="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" required class="form-control" /></div>
            <div class="col-12"><button class="btn btn-primary" type="submit">Registrar</button></div>
        </form></div></div></section>
    <section class="col-md-6"><div class="card"><div class="card-body"><h2 class="h4">Registrar despesa</h2>
        <form asp-action="Despesa" method="post" class="row g-2">
            <div class="col-12"><label class="form-label">Descrição</label><input name="Descricao" maxlength="200" required class="form-control" /></div>
            <div class="col-6"><label class="form-label">Valor</label><input name="Valor" type="text" inputmode="decimal" data-money-mask required class="form-control" /></div>
            <div class="col-6"><label class="form-label">Competência</label><input name="Data" type="date" value="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" required class="form-control" /></div>
            <div class="col-12"><label><input name="Paga" type="checkbox" value="true" /> Já foi paga</label></div>
            <div class="col-12"><button class="btn btn-primary" type="submit">Registrar</button></div>
        </form></div></div></section>
</div>
@section Scripts {
<script>
(() => {
    const explicacoes = {
        'kpi-sales': 'Soma o valor das vendas registradas no período, mesmo que parte ainda não tenha sido recebida.',
        'kpi-received': 'Soma os pagamentos recebidos no período, incluindo entradas e parcelas pagas.',
        'kpi-purchases': 'Soma o custo das entradas de estoque registradas no período, independentemente do pagamento.',
        'kpi-cogs': 'Custo histórico dos produtos vendidos no período, apurado pelo custo médio registrado na saída.',
        'kpi-gross': 'Vendas realizadas menos o custo histórico dos produtos vendidos.',
        'kpi-expenses': 'Soma as despesas cuja competência está dentro do período selecionado.',
        'kpi-net': 'Lucro bruto menos as despesas por competência. É uma estimativa do resultado líquido.',
        'kpi-roi': 'Lucro líquido estimado dividido pelo capital investido acumulado até o fim do período.',
        'kpi-investment': 'Soma dos investimentos registrados dentro do período selecionado.',
        'kpi-capital': 'Total acumulado de investimentos registrados até o fim do período.',
        'kpi-receivable': 'Saldo das vendas realizadas até o fim do período que ainda não foi recebido.',
        'kpi-payable': 'Saldo das compras de estoque realizadas até o fim do período que ainda não foi pago.'
    };
    document.querySelectorAll('.kpi-card').forEach(card => {
        const classe = [...card.classList].find(nome => explicacoes[nome]);
        if (!classe) return;
        const ajuda = document.createElement('button');
        ajuda.type = 'button';
        ajuda.className = 'kpi-help';
        ajuda.textContent = '?';
        ajuda.title = explicacoes[classe];
        ajuda.setAttribute('aria-label', `Ajuda: ${explicacoes[classe]}`);
        ajuda.dataset.bsToggle = 'tooltip';
        ajuda.dataset.bsPlacement = 'top';
        card.prepend(ajuda);
        bootstrap.Tooltip.getOrCreateInstance(ajuda, { trigger: 'hover focus' });
    });
})();
</script>
}
<h2 class="h4">Despesas</h2>
<table class="table table-striped"><thead><tr><th>Competência</th><th>Descrição</th><th>Valor</th><th>Situação</th><th></th></tr></thead><tbody>
@foreach (var despesa in Model.Despesas.OrderByDescending(x => x.DataCompetencia))
{
    <tr><td>@despesa.DataCompetencia.ToString("dd/MM/yyyy")</td><td>@despesa.Descricao</td><td>@despesa.Valor.ToString("C")</td>
        <td>@(despesa.PagaEm.HasValue ? "Paga" : "Em aberto")</td><td>
        @if (!despesa.PagaEm.HasValue)
        {
            <form asp-action="PagarDespesa" asp-route-id="@despesa.Id" method="post"><button class="btn btn-sm btn-outline-primary" type="submit">Marcar paga</button></form>
        }</td></tr>
}
</tbody></table>
<h2 class="h4">Investimentos</h2>
<table class="table table-striped"><thead><tr><th>Data</th><th>Descrição</th><th>Valor</th></tr></thead><tbody>
@foreach (var investimento in Model.Investimentos.OrderByDescending(x => x.Data))
{
    <tr><td>@investimento.Data.ToString("dd/MM/yyyy")</td><td>@investimento.Descricao</td><td>@investimento.Valor.ToString("C")</td></tr>
}
</tbody></table>
