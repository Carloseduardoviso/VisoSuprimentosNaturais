@model IReadOnlyList<VisoERP.Application.DTOs.Cadastros.ClienteDto>
@{ ViewData["Title"] = "Clientes"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Clientes</h1><a asp-action="Novo" class="btn btn-primary">Novo cliente</a></div>
<table class="table table-striped"><thead><tr><th>Nome</th><th>Documento</th><th>E-mail</th><th>Telefone</th><th>Situação</th><th>Ações</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.Nome</td><td>@item.Documento</td><td>@item.Email</td><td>@item.Telefone</td><td>@(item.Ativo ? "Ativo" : "Inativo")</td><td><a asp-action="Editar" asp-route-id="@item.Id">Editar</a></td></tr> }
</tbody></table>
