@model IReadOnlyList<VisoERP.Application.DTOs.Cadastros.FornecedorDto>
@{ ViewData["Title"] = "Fornecedores"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Fornecedores</h1><a asp-action="Novo" class="btn btn-primary">Novo fornecedor</a></div>
<table class="table table-striped"><thead><tr><th>Nome</th><th>Telefone</th><th>Situação</th><th>Ações</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.Nome</td><td>@item.Telefone</td><td>@(item.Ativo ? "Ativo" : "Inativo")</td><td><a asp-action="Editar" asp-route-id="@item.Id">Editar</a></td></tr> }
</tbody></table>
