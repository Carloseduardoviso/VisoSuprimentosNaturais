@model VisoERP.Web.Models.Cadastros.SuprimentoViewModel
@{ ViewData["Title"] = Model.Id.HasValue ? "Editar suplemento alimentar" : "Novo suplemento alimentar"; }
<h1>@ViewData["Title"]</h1>
<form asp-action="Salvar" method="post" enctype="multipart/form-data" class="row g-3">
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="col-12"><label asp-for="Nome" class="form-label"></label><input asp-for="Nome" class="form-control" /><span asp-validation-for="Nome" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="PrecoCatalogo" class="form-label">Pre�o de cat�logo (venda)</label><input asp-for="PrecoCatalogo" type="text" inputmode="decimal" data-money-mask class="form-control" /><span asp-validation-for="PrecoCatalogo" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="PorcentagemDesconto" class="form-label">Porcentagem de desconto</label><input asp-for="PorcentagemDesconto" value="@(Model.Id.HasValue ? Model.PorcentagemDesconto.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) : "")" type="number" min="0" max="100" step="0.01" class="form-control no-spinner" /><span asp-validation-for="PorcentagemDesconto" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="PrecoComDesconto" class="form-label">Pre�o com desconto (compra do fornecedor)</label><input asp-for="PrecoComDesconto" type="text" inputmode="decimal" data-money-mask class="form-control" /><span asp-validation-for="PrecoComDesconto" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="CategoriaId" class="form-label">Categoria</label><select asp-for="CategoriaId" asp-items="ViewBag.Categorias" class="form-select"><option value="">Sem categoria</option></select></div>
    <div class="col-md-6"><label asp-for="EstoqueMinimo" class="form-label">Estoque m�nimo</label><input asp-for="EstoqueMinimo" value="@(Model.Id.HasValue ? Model.EstoqueMinimo.ToString() : "")" type="number" min="0" step="1" class="form-control no-spinner" /><span asp-validation-for="EstoqueMinimo" class="text-danger"></span></div>
    <div class="col-12"><div class="d-flex justify-content-between align-items-center"><label asp-for="Descricao" class="form-label">Descri��o</label><button type="button" class="btn btn-sm btn-outline-secondary" data-copy-field="Descricao">Copiar</button></div><textarea asp-for="Descricao" class="form-control" rows="3"></textarea></div>
    <div class="col-12"><div class="d-flex justify-content-between align-items-center"><label asp-for="FormaDeUso" class="form-label">Forma de tomar ou usar</label><button type="button" class="btn btn-sm btn-outline-secondary" data-copy-field="FormaDeUso">Copiar</button></div><textarea asp-for="FormaDeUso" class="form-control" rows="3"></textarea></div>
    <div class="col-md-8"><label asp-for="Imagem" class="form-label">Imagem (JPG, PNG ou WebP at� 2 MB)</label><input asp-for="Imagem" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp" /></div>
    <div class="col-md-4 align-self-end"><div class="form-check"><input asp-for="Ativo" class="form-check-input" /><label asp-for="Ativo" class="form-check-label">Ativo</label></div></div>
    <div class="col-12"><button class="btn btn-primary" type="submit">Salvar</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const precoCatalogo = document.getElementById('PrecoCatalogo');
        const porcentagemDesconto = document.getElementById('PorcentagemDesconto');
        const precoComDesconto = document.getElementById('PrecoComDesconto');
        const recalcularPrecoCompra = () => {
            const catalogo = window.VisoMoney.numero(precoCatalogo.value) || 0;
            const percentual = Number(porcentagemDesconto.value) || 0;
            precoComDesconto.value = window.VisoMoney.formatarValorServidor(catalogo * (1 - percentual / 100));
        };
        [precoCatalogo, porcentagemDesconto].forEach(campo => campo.addEventListener('input', recalcularPrecoCompra));
        [porcentagemDesconto, document.getElementById('EstoqueMinimo')].forEach(campo => campo.addEventListener('input', () => {
            if (Number(campo.value) < 0) campo.value = 0;
        }));
        document.querySelectorAll('[data-copy-field]').forEach(botao => {
            botao.addEventListener('click', async () => {
                const campo = document.getElementById(botao.dataset.copyField);
                if (!campo || !campo.value) return;

                try {
                    await navigator.clipboard.writeText(campo.value);
                    const textoOriginal = botao.textContent;
                    botao.textContent = 'Copiado';
                    window.setTimeout(() => botao.textContent = textoOriginal, 1500);
                } catch {
                    campo.select();
                    document.execCommand('copy');
                    campo.setSelectionRange(campo.value.length, campo.value.length);
                }
            });
        });
    </script>
}
