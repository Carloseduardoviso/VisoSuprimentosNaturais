@model IReadOnlyList<VisoERP.Application.DTOs.Cadastros.SuprimentoDto>
@{ ViewData["Title"] = "Suplementos alimentares"; }
<div class="suprimentos-heading d-flex justify-content-between align-items-center mb-3"><div><span class="section-kicker">Catálogo</span><h1>Suplementos alimentares</h1><p>Gerencie seus produtos naturais e condiçóes de compra.</p></div><div class="d-flex gap-2"><button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#descontoModal">Alterar desconto por categoria</button><a asp-action="Novo" class="btn btn-primary">+ Novo suplemento</a></div></div>
@if (TempData["Mensagem"] is not null) { <div class="alert alert-success">@TempData["Mensagem"]</div> }
@if (TempData["Erro"] is not null) { <div class="alert alert-danger">@TempData["Erro"]</div> }
<div class="modal fade" id="descontoModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><form asp-action="AplicarDesconto" method="post"><div class="modal-header"><h2 class="modal-title h5">Alterar desconto por categoria</h2><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><label class="form-label">Categoria</label><select name="categoriaId" class="form-select mb-3" required><option value="">Selecione</option>@foreach (var categoria in ViewBag.Categorias) { <option value="@categoria.Id">@categoria.Nome</option> }</select><label class="form-label">Porcentagem de desconto</label><input name="percentual" type="number" min="0" max="100" step="0.01" class="form-control no-spinner" required /></div><div class="modal-footer"><button type="submit" class="btn btn-primary">Aplicar</button></div></form></div></div></div>
<div class="table-shell suprimentos-table-shell">
<table class="table table-striped align-middle"><thead><tr><th>Imagem</th><th>Código</th><th>Nome</th><th>Categoria</th><th>Preço de catálogo (venda)</th><th>Preço com desconto (compra)</th><th>Compra mínima</th><th>Situação</th><th>Ações</th></tr></thead><tbody>
@foreach (var item in Model) {
<tr class="suprimentos-row"><td data-label="Imagem">@if (item.ImagemCaminho is not null) { <img src="@Url.Action("Imagem", new { id = item.Id })" alt="@item.Nome" width="48" height="48" style="object-fit:cover" /> }</td><td data-label="Código">@item.CodigoInterno</td><td data-label="Nome">@item.Nome</td><td data-label="Categoria">@(item.CategoriaNome ?? "Sem categoria")</td><td data-label="Preço de catálogo (venda)">@item.PrecoCatalogo.ToString("C")</td><td data-label="Preço com desconto (compra)">@item.PrecoComDesconto.ToString("C")</td><td data-label="Compra mínima">@item.QuantidadeMinimaCompra</td><td data-label="Situação">@(item.Ativo ? "Ativo" : "Inativo")</td><td data-label="Ações"><a asp-action="Editar" asp-route-id="@item.Id">Editar</a></td></tr>
}
</tbody></table>
</div>

