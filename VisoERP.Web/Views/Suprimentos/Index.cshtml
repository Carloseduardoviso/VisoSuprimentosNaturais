@model IReadOnlyList<VisoERP.Application.DTOs.Cadastros.SuprimentoDto>
@{ ViewData["Title"] = "Suprimentos"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Suprimentos</h1><a asp-action="Novo" class="btn btn-primary">Novo suprimento</a></div>
<table class="table table-striped align-middle"><thead><tr><th>Imagem</th><th>Código</th><th>Nome</th><th>Preço de catálogo (venda)</th><th>Preço com desconto (compra)</th><th>Compra mínima</th><th>Situação</th><th></th></tr></thead><tbody>
@foreach (var item in Model) {
<tr><td>@if (item.ImagemCaminho is not null) { <img src="@Url.Action("Imagem", new { id = item.Id })" alt="" width="48" height="48" style="object-fit:cover" /> }</td><td>@item.CodigoInterno</td><td>@item.Nome</td><td>@item.PrecoCatalogo.ToString("C")</td><td>@item.PrecoComDesconto.ToString("C")</td><td>@item.QuantidadeMinimaCompra</td><td>@(item.Ativo ? "Ativo" : "Inativo")</td><td><a asp-action="Editar" asp-route-id="@item.Id">Editar</a></td></tr>
}
</tbody></table>
