@model IReadOnlyList<VisoERP.Application.DTOs.Estoque.EntradaEstoqueDto>
@{ ViewData["Title"] = "Entradas de estoque"; }
@if (TempData["Erro"] is string erro) { <div class="alert alert-danger">@erro</div> }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Entradas de estoque</h1><a class="btn btn-primary" asp-action="Nova">Nova entrada</a></div>
<table class="table table-striped"><thead><tr><th>Data</th><th>Itens</th><th>Total Desconto</th><th>Valor Catálogo</th><th>Ações</th></tr></thead><tbody>
@{ var categorias = (IReadOnlyDictionary<Guid, string>)ViewBag.CategoriasSuprimentos; var precosCatalogo = (IReadOnlyDictionary<Guid, decimal>)ViewBag.PrecosCatalogo; }
@foreach (var entrada in Model)
{
    var grupos = entrada.Itens.GroupBy(x => categorias.TryGetValue(x.SuprimentoId, out var categoria) ? categoria : "Sem categoria").OrderBy(x => x.Key).ToList();
    <tr><td data-label="Data">@entrada.CriadaEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td data-label="Itens">@entrada.Itens.Count</td><td data-label="Total Desconto">@foreach (var grupo in grupos) { <div>@grupo.Key: @grupo.Sum(x => x.Quantidade * x.CustoUnitario).ToString("C")</div> }</td><td data-label="Valor Catálogo">@foreach (var grupo in grupos) { <div>@grupo.Key: @grupo.Sum(x => x.Quantidade * (precosCatalogo.TryGetValue(x.SuprimentoId, out var preco) ? preco : x.CustoUnitario)).ToString("C")</div> }</td>
        <td><div class="d-flex align-items-center gap-2 flex-nowrap"><a asp-action="Detalhes" asp-route-id="@entrada.Id" class="btn btn-sm btn-outline-primary text-nowrap">Ver detalhes</a><a asp-action="Editar" asp-route-id="@entrada.Id" class="btn btn-sm btn-outline-secondary text-nowrap">Editar</a><form asp-action="Excluir" asp-route-id="@entrada.Id" method="post" class="d-inline js-excluir-entrada"><button class="btn btn-sm btn-outline-danger text-nowrap" type="submit">Excluir</button></form></div></td></tr>
}
</tbody></table>
@section Scripts {
<script>
document.querySelectorAll('.js-excluir-entrada').forEach(form => {
    form.addEventListener('submit', event => {
        event.preventDefault();
        Swal.fire({ title: 'Excluir entrada?', text: 'O estoque e os lançamentos vinculados serão estornados.', icon: 'warning', showCancelButton: true, confirmButtonText: 'Sim, excluir', cancelButtonText: 'Cancelar', reverseButtons: true, confirmButtonColor: '#dc3545', cancelButtonColor: '#6c757d' }).then(result => { if (result.isConfirmed) form.submit(); });
    });
});
</script>
}
