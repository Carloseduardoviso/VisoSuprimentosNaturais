@model IReadOnlyList<VisoERP.Application.DTOs.Estoque.EntradaEstoqueDto>
@{ ViewData["Title"] = "Entradas de estoque"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Entradas de estoque</h1><a class="btn btn-primary" asp-action="Nova">Nova entrada</a></div>
<table class="table table-striped"><thead><tr><th>Data</th><th>Pedido</th><th>Itens</th><th>Custo total</th></tr></thead><tbody>
@foreach (var entrada in Model)
{
    <tr><td>@entrada.CriadaEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@entrada.PedidoFornecedorId</td>
        <td>@entrada.Itens.Count</td><td>@entrada.TotalCusto.ToString("C")</td></tr>
}
</tbody></table>
