@model IReadOnlyList<VisoERP.Application.DTOs.Estoque.EntradaEstoqueDto>
@{ ViewData["Title"] = "Entradas de estoque"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Entradas de estoque</h1><a class="btn btn-primary" asp-action="Nova">Nova entrada</a></div>
<table class="table table-striped"><thead><tr><th>Data</th><th>Itens</th><th>Total Desconto</th><th>Valor Catálogo</th><th>Ações</th></tr></thead><tbody>
@foreach (var entrada in Model)
{
    <tr><td data-label="Data">@entrada.CriadaEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td data-label="Itens">@entrada.Itens.Count</td><td data-label="Total Desconto">@entrada.TotalDesconto.ToString("C")</td><td data-label="Valor Catálogo">@entrada.TotalCatalogo.ToString("C")</td>
        <td><div class="d-flex align-items-center gap-2 flex-nowrap"><a asp-action="Detalhes" asp-route-id="@entrada.Id" class="btn btn-sm btn-outline-primary text-nowrap">Ver detalhes</a><a asp-action="Editar" asp-route-id="@entrada.Id" class="btn btn-sm btn-outline-secondary text-nowrap">Editar</a></div></td></tr>
}
</tbody></table>
