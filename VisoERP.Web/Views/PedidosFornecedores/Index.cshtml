@model IReadOnlyList<VisoERP.Application.DTOs.Comercial.PedidoFornecedorDto>
@{ ViewData["Title"] = "Pedidos a fornecedores"; }
@if (TempData["Erro"] is string erro) { <div class="alert alert-danger">@erro</div> }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Pedidos a fornecedores</h1><a class="btn btn-primary" asp-action="Novo">Novo pedido</a></div>
<table class="table table-striped"><thead><tr><th>Data</th><th>Fornecedor</th><th>Situação</th><th>Total Desconto</th><th>Valor Catálogo</th><th>Ações</th></tr></thead><tbody>
@{ var categorias = (IReadOnlyDictionary<Guid, string>)ViewBag.CategoriasSuprimentos; }
@foreach (var pedido in Model)
{
    var grupos = pedido.Itens.GroupBy(x => categorias.TryGetValue(x.SuprimentoId, out var categoria) ? categoria : "Sem categoria").OrderBy(x => x.Key).ToList();
    <tr><td data-label="Data">@pedido.DataCriacao.ToLocalTime().ToString("dd/MM/yyyy")</td><td data-label="Fornecedor">@(((IReadOnlyDictionary<Guid, string>)ViewBag.Fornecedores).TryGetValue(pedido.FornecedorId, out var fornecedor) ? fornecedor : "Fornecedor não encontrado")</td><td data-label="Situação">@pedido.Situacao</td><td data-label="Total Desconto">@foreach (var grupo in grupos) { <div>@grupo.Key: @grupo.Sum(x => x.Total).ToString("C")</div> }</td><td data-label="Valor Catálogo">@foreach (var grupo in grupos) { <div>@grupo.Key: @grupo.Sum(x => x.Quantidade * x.PrecoCatalogo).ToString("C")</div> }</td>
        <td class="d-flex gap-2"><a class="btn btn-sm btn-outline-primary" asp-action="Detalhes" asp-route-id="@pedido.Id">Ver detalhes</a>
            @if (pedido.Situacao == "Pendente")
            {
                <a class="btn btn-sm btn-outline-secondary" asp-action="Editar" asp-route-id="@pedido.Id">Editar</a>
                <form asp-action="Excluir" asp-route-id="@pedido.Id" method="post" class="d-inline" onsubmit="return confirm('Excluir este pedido?');"><button class="btn btn-sm btn-outline-danger" type="submit">Excluir</button></form>
            }
        </td></tr>
}
</tbody></table>
