@model IReadOnlyList<VisoERP.Application.DTOs.Comercial.PedidoFornecedorDto>
@{ ViewData["Title"] = "Pedidos a fornecedores"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Pedidos a fornecedores</h1>
    <a class="btn btn-primary" asp-action="Novo">Novo pedido</a>
</div>
<table class="table table-striped">
    <thead><tr><th>Data</th><th>Fornecedor</th><th>Situação</th><th>Total</th><th></th></tr></thead>
    <tbody>
    @foreach (var pedido in Model)
    {
        <tr><td>@pedido.DataCriacao.ToLocalTime().ToString("dd/MM/yyyy")</td>
            <td>@(((IReadOnlyDictionary<Guid, string>)ViewBag.Fornecedores).TryGetValue(pedido.FornecedorId, out var fornecedor) ? fornecedor : "Fornecedor não encontrado")</td><td>@pedido.Situacao</td>
            <td>@pedido.Total.ToString("C")</td>
            <td class="d-flex gap-2"><a class="btn btn-sm btn-outline-primary" asp-action="Detalhes" asp-route-id="@pedido.Id">Ver detalhes</a>@if (pedido.Situacao == "Pendente") { <button type="button" class="btn btn-sm btn-outline-secondary copiar-pedido" data-mensagem-url="@Url.Action("Mensagem", new { id = pedido.Id })">Copiar</button><a class="btn btn-sm btn-success" asp-action="WhatsApp" asp-route-id="@pedido.Id" target="_blank" rel="noopener" aria-label="Enviar pedido pelo WhatsApp">WhatsApp</a> } else { <button type="button" class="btn btn-sm btn-outline-secondary" disabled>Copiar</button><button type="button" class="btn btn-sm btn-success" disabled>WhatsApp</button> }</td></tr>
    }
    </tbody>
</table>
@section Scripts { <script>
document.querySelectorAll('.copiar-pedido').forEach(botao => botao.addEventListener('click', async () => {
    const mensagem = await fetch(botao.dataset.mensagemUrl).then(resposta => resposta.text());
    await navigator.clipboard.writeText(mensagem);
    const texto = botao.textContent; botao.textContent = 'Copiado!';
    setTimeout(() => botao.textContent = texto, 1600);
}));
</script> }
