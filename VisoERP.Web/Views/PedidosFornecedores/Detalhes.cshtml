@model VisoERP.Application.DTOs.Comercial.PedidoFornecedorDto
@{ ViewData["Title"] = "Pedido"; }
<h1>Pedido a fornecedor</h1>
<p><strong>Situação:</strong> @Model.Situacao &nbsp; <strong>Total:</strong> @Model.Total.ToString("C")</p>
@if (TempData["Erro"] is string erro) { <div class="alert alert-danger">@erro</div> }
<table class="table table-striped">
    <thead><tr><th>Suplemento alimentar</th><th>Quantidade</th><th>Recebida</th><th>Preço catálogo</th><th>Preço com desconto</th><th>Total</th></tr></thead>
    <tbody>
    @foreach (var item in Model.Itens)
    {
        <tr><td>@(((IReadOnlyDictionary<Guid, string>)ViewBag.Suplementos).TryGetValue(item.SuprimentoId, out var nome) ? nome : "Suplemento alimentar não encontrado")</td><td>@item.Quantidade</td><td>@item.QuantidadeRecebida</td>
            <td>@item.PrecoCatalogo.ToString("C")</td><td>@item.PrecoComDesconto.ToString("C")</td><td>@item.Total.ToString("C")</td></tr>
        @if (Model.Situacao == "Pendente") { <tr><td colspan="6"><form asp-action="RegistrarFalta" method="post" target="_blank" class="d-flex gap-2 align-items-center"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="suplementoId" value="@item.SuprimentoId" /><span>Não chegou:</span><input name="quantidade" type="number" min="1" step="1" class="form-control form-control-sm" style="max-width:100px" required /><button class="btn btn-sm btn-outline-primary">Registrar falta e avisar fornecedor</button></form></td></tr> }
    }
    </tbody>
</table>
@if (Model.Situacao is "Pendente" or "Parcial")
{
    <a class="btn btn-primary" asp-controller="Entradas" asp-action="Nova" asp-route-pedidoFornecedorId="@Model.Id">Confirmar recebimento</a>
}
@if (Model.Situacao == "Pendente")
{
    <form asp-action="Cancelar" asp-route-id="@Model.Id" method="post" class="d-inline" target="_blank">
        <button class="btn btn-outline-danger" type="submit">Cancelar pedido</button>
    </form>
}
<a class="btn btn-link" asp-action="Index">Voltar</a>
