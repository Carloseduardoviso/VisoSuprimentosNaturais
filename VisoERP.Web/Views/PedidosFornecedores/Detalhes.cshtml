@model VisoERP.Application.DTOs.Comercial.PedidoFornecedorDto
@{ ViewData["Title"] = "Pedido"; }
<h1>Pedido a fornecedor</h1>
<p><strong>Situa��o:</strong> @Model.Situacao &nbsp; <strong>Total:</strong> @Model.Total.ToString("C")</p>
@if (TempData["Erro"] is string erro) { <div class="alert alert-danger">@erro</div> }
<table class="table table-striped">
    <thead><tr><th>Suplemento alimentar</th><th>Quantidade</th><th>Recebida</th><th>Pre�o cat�logo</th><th>Pre�o com desconto</th><th>Total</th></tr></thead>
    <tbody>
    @foreach (var item in Model.Itens)
    {
        <tr><td>@(((IReadOnlyDictionary<Guid, string>)ViewBag.Suplementos).TryGetValue(item.SuprimentoId, out var nome) ? nome : "Suplemento alimentar n�o encontrado")</td><td>@item.Quantidade.ToString("0")</td><td>@item.QuantidadeRecebida.ToString("0")</td>
            <td>@item.PrecoCatalogo.ToString("C")</td><td>@item.PrecoComDesconto.ToString("C")</td><td>@item.Total.ToString("C")</td></tr>
        @if ((Model.Situacao is "Pendente" or "Parcial") && item.QuantidadeRecebida < item.Quantidade) { <tr><td colspan="6"><div class="d-flex gap-2 align-items-center"><span>Recebido:</span><input form="recebimento-form" name="recebidos[@item.SuprimentoId]" type="number" min="0" max="@(item.Quantidade - item.QuantidadeRecebida)" step="1" class="form-control form-control-sm" style="max-width:100px" /></div></td></tr> }
    }
    </tbody>
</table>
<div class="d-flex flex-wrap align-items-center gap-2">
@if (Model.Situacao is "Pendente" or "Parcial") { <form id="recebimento-form" asp-action="RegistrarRecebimento" method="post"><input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-outline-primary">Salvar recebimento</button></form> }
@if (Model.Situacao is "Pendente" or "Parcial")
{
}
@if (Model.Situacao == "Pendente")
{
    <form asp-action="Cancelar" asp-route-id="@Model.Id" method="post" class="d-inline" target="_blank">
        <button class="btn btn-outline-danger" type="submit">Cancelar pedido</button>
    </form>
}
<a class="btn btn-link" asp-action="Index">Voltar</a>
</div>
