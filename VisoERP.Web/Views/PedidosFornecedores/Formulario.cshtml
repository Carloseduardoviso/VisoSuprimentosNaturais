@model VisoERP.Web.Models.Comercial.PedidoFornecedorViewModel
@using System.Text.Json
@using System.Globalization
@{ ViewData["Title"] = "Novo pedido"; }
<h1>Novo pedido a fornecedor</h1>
<form asp-action="@(ViewContext.RouteData.Values["action"]?.ToString() == "Editar" ? "Atualizar" : "Salvar")" asp-route-id="@(ViewContext.RouteData.Values["id"] ?? "")" method="post" id="pedido-form">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><label asp-for="FornecedorId" class="form-label">Fornecedor</label>
        <select asp-for="FornecedorId" asp-items="ViewBag.Fornecedores" class="form-select"><option value="">Selecione</option></select></div>
    <div class="mb-3 row g-3 align-items-end"><div class="col-md-4"><label asp-for="DataPedido" class="form-label">Data do pedido</label><input asp-for="DataPedido" type="date" class="form-control" /></div><div class="col-md-8"><span class="form-label d-block">Descontos por categoria</span><div class="d-flex flex-wrap gap-2">@if (ViewBag.DescontosCategorias is IEnumerable<dynamic> descontos && descontos.Any()) { foreach (var desconto in descontos) { <span class="form-control bg-body-secondary w-auto">@desconto.Categoria: @desconto.Percentual.ToString("0.##")%</span> } } else { <span class="form-control bg-body-secondary">Nenhum desconto de categoria cadastrado</span> }</div></div></div>
    <div id="itens"></div>
    <button type="button" id="adicionar" class="btn btn-outline-primary mb-3">Adicionar suplemento alimentar</button>
    <div><button type="submit" class="btn btn-primary">@(ViewContext.RouteData.Values["action"]?.ToString() == "Editar" ? "Salvar alterações" : "Criar pedido")</button> <a asp-action="Index" class="btn btn-link">Cancelar</a></div>
</form>
<template id="item-template"><div class="card mb-3 item-card"><div class="card-body">
    <div class="d-flex justify-content-between"><h2 class="h5">Suplemento alimentar</h2><button type="button" class="btn btn-sm btn-outline-danger remover">Excluir</button></div>
    <div class="row g-2">
        <div class="col-md-4"><label class="form-label">Suplemento alimentar</label><select class="form-select produto" data-campo="SuprimentoId" required><option value="">Selecione</option>
        @foreach (var produto in ViewBag.Suprimentos) { <option value="@produto.Id" data-catalogo="@produto.PrecoCatalogo.ToString(CultureInfo.InvariantCulture)" data-desconto="@produto.PrecoComDesconto.ToString(CultureInfo.InvariantCulture)" data-estoque="@produto.Estoque.ToString(CultureInfo.InvariantCulture)">@produto.Nome</option> }
        </select></div>
        <div class="col-md-2"><label class="form-label mb-0">Quantidade</label><small class="text-muted d-block estoque-disponivel"></small><input type="number" min="0.001" step="0.001" class="form-control" data-campo="Quantidade" required /></div>
        <div class="col-md-3"><label class="form-label">Preço catálogo</label><input type="text" data-money-mask class="form-control bg-body-secondary text-muted" data-campo="PrecoCatalogo" readonly aria-readonly="true" required /></div>
        <div class="col-md-3"><label class="form-label">Preço com desconto</label><input type="text" data-money-mask class="form-control bg-body-secondary text-muted" data-campo="PrecoComDesconto" readonly aria-readonly="true" required /></div>
    </div></div></div></template>
@section Scripts {
<script>
(() => {
    const container = document.getElementById('itens');
    const template = document.getElementById('item-template');
    function reindex() { container.querySelectorAll('.item-card').forEach((card, i) =>
        card.querySelectorAll('[data-campo]').forEach(el => el.name = `Itens[${i}].${el.dataset.campo}`)); }
    function add(item = {}) {
        const card = template.content.firstElementChild.cloneNode(true);
        container.appendChild(card);
        card.querySelector('.produto').value = item.SuprimentoId || '';
        for (const field of ['Quantidade','PrecoCatalogo','PrecoComDesconto']) {
            const element = card.querySelector(`[data-campo="${field}"]`);
            const valor = item[field] ?? (field === 'Quantidade' ? 1 : 0);
            element.value = element.matches('[data-money-mask]')
                ? window.VisoMoney.formatarValorServidor(valor)
                : valor;
        }
        const optionInicial = card.querySelector('.produto').selectedOptions[0];
        const formatarEstoque = valor => new Intl.NumberFormat('pt-BR', { maximumFractionDigits: 3 }).format(Number(valor || 0));
        card.querySelector('.estoque-disponivel').textContent = optionInicial?.value ? `Estoque disponível: ${formatarEstoque(optionInicial.dataset.estoque)}` : '';
        card.querySelector('.produto').addEventListener('change', e => {
            const option = e.target.selectedOptions[0];
            card.querySelector('.estoque-disponivel').textContent = option?.value ? `Estoque disponível: ${formatarEstoque(option.dataset.estoque)}` : '';
            const precoCatalogo = card.querySelector('[data-campo="PrecoCatalogo"]');
            const precoComDesconto = card.querySelector('[data-campo="PrecoComDesconto"]');
            precoCatalogo.value = window.VisoMoney.formatarValorServidor(option?.dataset.catalogo || 0);
            precoComDesconto.value = window.VisoMoney.formatarValorServidor(option?.dataset.desconto || 0);
        });
        card.querySelector('.remover').addEventListener('click', () => { card.remove(); reindex(); });
        reindex();
    }
    document.getElementById('adicionar').addEventListener('click', () => add());
    const initial = @Html.Raw(JsonSerializer.Serialize(Model.Itens));
    initial.forEach(add);
})();
</script>
}
