@model IReadOnlyList<VisoERP.Application.DTOs.Cadastros.CategoriaDto>
@{ ViewData["Title"] = "Categorias"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Categorias</h1><a asp-action="Novo" class="btn btn-primary">Nova categoria</a></div>
<table class="table table-striped"><thead><tr><th>Nome</th><th>Situação</th><th>Ações</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.Nome</td><td>@(item.Ativa ? "Ativa" : "Inativa")</td><td><a asp-action="Editar" asp-route-id="@item.Id">Editar</a></td></tr> }
</tbody></table>
