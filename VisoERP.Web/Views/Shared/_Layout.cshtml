<!DOCTYPE html>
@{
    var podeEstoque = User.Identity?.IsAuthenticated == true;
    var podeVendas = User.Identity?.IsAuthenticated == true;
    var podeFinanceiro = User.Identity?.IsAuthenticated == true;
}
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#143d2b" />
    <title>@ViewData["Title"] - VISO Suplementos Alimentares Naturais</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark brand-navbar mb-4" aria-label="Navega��o principal">
            <div class="container-fluid px-3 px-lg-4">
                <a class="navbar-brand brand-lockup" asp-area="" asp-controller="Home" asp-action="Index" aria-label="VISO Suplementos Alimentares Naturais, in�cio">
                    <span class="brand-mark"><img src="~/images/viso-leaf.svg" alt="" /></span>
                    <span class="brand-name"><strong>VISO</strong><small>SUPLEMENTOS ALIMENTARES NATURAIS</small></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">In�cio</a>
                        </li>
                        @if (podeEstoque || podeVendas)
                        {
                            <li class="nav-item dropdown">
                                <button class="nav-link dropdown-toggle brand-menu-trigger" type="button" data-bs-toggle="dropdown" aria-expanded="false">Cadastros</button>
                                <ul class="dropdown-menu">
                                    @if (podeEstoque)
                                    {
                                        <li><a class="dropdown-item" asp-controller="Suprimentos" asp-action="Index">Suplementos alimentares</a></li>
                                        <li><a class="dropdown-item" asp-controller="Categorias" asp-action="Index">Categorias</a></li>
                                        <li><a class="dropdown-item" asp-controller="Fornecedores" asp-action="Index">Fornecedores</a></li>
                                    }
                                    @if (podeVendas)
                                    {
                                        <li><a class="dropdown-item" asp-controller="Clientes" asp-action="Index">Clientes</a></li>
                                    }
                                </ul>
                            </li>
                        }
                        @if (podeEstoque)
                        {
                            <li class="nav-item dropdown">
                                <button class="nav-link dropdown-toggle brand-menu-trigger" type="button" data-bs-toggle="dropdown" aria-expanded="false">Estoque</button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="PedidosFornecedores" asp-action="Index">Pedidos a fornecedores</a></li>
                                    <li><a class="dropdown-item" asp-controller="Entradas" asp-action="Index">Entradas</a></li>
                                </ul>
                            </li>
                        }
                        @if (podeVendas)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Vendas" asp-action="Index">Vendas</a></li>
                        }
                        @if (podeFinanceiro)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Financeiro" asp-action="Index">Financeiro</a></li>
                        }
                    </ul>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-controller="Conta" asp-action="Sair" method="post" class="d-flex align-items-center gap-2">
                            <span class="small text-white-50">@User.Identity.Name</span>
                            <button class="btn btn-outline-light btn-sm" type="submit">Sair</button>
                        </form>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container-xl app-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="brand-footer">
        <div class="container-xl d-flex flex-wrap justify-content-between gap-2">
            <span>&copy; 2026 VISO Suplementos Alimentares Naturais</span>
            <span>O melhor da natureza para voc�.</span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/money-mask.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
