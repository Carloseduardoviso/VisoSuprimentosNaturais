<!DOCTYPE html>
@inject Microsoft.Extensions.Configuration.IConfiguration Configuracao
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Ambiente
@{
    var acessoLocal = Ambiente.EnvironmentName == "Development" &&
        bool.TryParse(Configuracao["Authentication:AllowAnonymousDevelopment"], out var liberado) && liberado;
    var podeEstoque = acessoLocal || User.IsInRole("Administrador") || User.IsInRole("Estoque");
    var podeVendas = acessoLocal || User.IsInRole("Administrador") || User.IsInRole("Vendas");
    var podeFinanceiro = acessoLocal || User.IsInRole("Administrador") || User.IsInRole("Financeiro");
}
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VISO ERP</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/VisoERP.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">VISO ERP</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Início</a>
                        </li>
                        @if (podeEstoque || podeVendas)
                        {
                            <li class="nav-item dropdown">
                                <button class="nav-link dropdown-toggle btn btn-link text-dark" type="button" data-bs-toggle="dropdown" aria-expanded="false">Cadastros</button>
                                <ul class="dropdown-menu">
                                    @if (podeEstoque)
                                    {
                                        <li><a class="dropdown-item" asp-controller="Suprimentos" asp-action="Index">Suprimentos</a></li>
                                        <li><a class="dropdown-item" asp-controller="Categorias" asp-action="Index">Categorias</a></li>
                                        <li><a class="dropdown-item" asp-controller="Fornecedores" asp-action="Index">Fornecedores</a></li>
                                    }
                                    @if (podeVendas)
                                    {
                                        <li><a class="dropdown-item" asp-controller="Clientes" asp-action="Index">Clientes</a></li>
                                    }
                                </ul>
                            </li>
                        }
                        @if (podeEstoque)
                        {
                            <li class="nav-item dropdown">
                                <button class="nav-link dropdown-toggle btn btn-link text-dark" type="button" data-bs-toggle="dropdown" aria-expanded="false">Estoque</button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="PedidosFornecedores" asp-action="Index">Pedidos a fornecedores</a></li>
                                    <li><a class="dropdown-item" asp-controller="Entradas" asp-action="Index">Entradas</a></li>
                                </ul>
                            </li>
                        }
                        @if (podeVendas)
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Vendas" asp-action="Index">Vendas</a></li>
                        }
                        @if (podeFinanceiro)
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Financeiro" asp-action="Index">Financeiro</a></li>
                        }
                    </ul>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-controller="Conta" asp-action="Sair" method="post" class="d-flex align-items-center gap-2">
                            <span class="small text-muted">@User.Identity.Name</span>
                            <button class="btn btn-outline-secondary btn-sm" type="submit">Sair</button>
                        </form>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - VISO SUPRIMENTOS NATURAIS
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
