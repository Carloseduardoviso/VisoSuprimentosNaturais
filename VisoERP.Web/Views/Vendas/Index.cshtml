@model IReadOnlyList<VisoERP.Application.DTOs.Comercial.VendaDto>
@{ ViewData["Title"] = "Vendas"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Vendas</h1><a class="btn btn-primary" asp-action="Nova">Nova venda</a></div>
<table class="table table-striped"><thead><tr><th>Data</th><th>Cliente</th><th>Total vendido</th><th>Recebido</th><th>Ações</th></tr></thead><tbody>
@foreach (var venda in Model)
{
    var nomes = (Dictionary<Guid, string>)ViewBag.Clientes;
    <tr><td data-label="Data">@venda.Data.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
        <td data-label="Cliente">@(nomes.TryGetValue(venda.ClienteId, out var nome) ? nome : venda.ClienteId.ToString())</td>
        <td data-label="Total vendido">@venda.Total.ToString("C")</td><td data-label="Recebido">@venda.ValorRecebido.ToString("C")</td>
        <td data-label="Ações"><a asp-action="Detalhes" asp-route-id="@venda.Id">Detalhes</a></td></tr>
}
</tbody></table>
