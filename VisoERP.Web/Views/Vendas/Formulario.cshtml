@model VisoERP.Web.Models.Comercial.VendaViewModel
@using System.Text.Json
@using System.Globalization
@{ ViewData["Title"] = "Nova venda"; }
<h1>Nova venda</h1>
<form asp-action="Registrar" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><label asp-for="ClienteId" class="form-label">Cliente</label>
        <select asp-for="ClienteId" asp-items="ViewBag.Clientes" class="form-select"><option value="">Selecione</option></select></div>
    <div id="itens"></div>
    <button type="button" id="adicionar" class="btn btn-outline-primary mb-3">Adicionar suplemento alimentar</button>
    <div class="row g-3 mb-3">
        <div class="col-md-3"><label asp-for="Desconto" class="form-label">Desconto total</label><input asp-for="Desconto" type="text" inputmode="decimal" data-money-mask class="form-control" /></div>
        <div class="col-md-3"><label asp-for="ValorEntrada" class="form-label">Entrada financeira recebida</label><input asp-for="ValorEntrada" type="text" inputmode="decimal" data-money-mask class="form-control" /></div>
        <div class="col-md-3"><label asp-for="NumeroParcelas" class="form-label">Parcelas do saldo</label><input asp-for="NumeroParcelas" type="number" min="0" max="12" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="PrimeiroVencimento" class="form-label">Primeiro vencimento</label><input asp-for="PrimeiroVencimento" type="date" class="form-control" /></div>
    </div>
    <div id="resumo" class="alert alert-info" aria-live="polite"></div>
    <section id="parcelas-previa" class="mb-4" hidden>
        <h2 class="h4">Parcelas da venda</h2>
        <p class="text-muted">Confira o vencimento e o valor de cada parcela. Depois de confirmar a venda, os pagamentos poderáo ser registrados em Financeiro.</p>
        <div class="table-responsive">
            <table class="table table-striped">
                <thead><tr><th>Cliente</th><th>Vencimento</th><th>Valor</th><th>Pago</th><th>Valor a receber</th></tr></thead>
                <tbody id="parcelas-previa-linhas"></tbody>
            </table>
        </div>
    </section>
    <button type="submit" class="btn btn-primary">Confirmar venda</button> <a asp-action="Index" class="btn btn-link">Cancelar</a>
</form>
<template id="item-template"><div class="card mb-3 item-card"><div class="card-body">
    <div class="d-flex justify-content-between"><h2 class="h5">Suplemento alimentar</h2><button type="button" class="btn btn-sm btn-outline-danger remover">Excluir</button></div>
    <div class="row g-2">
        <div class="col-md-4"><label class="form-label">Suplemento alimentar</label><select class="form-select produto" data-campo="SuprimentoId" required><option value="">Selecione</option>
        @foreach (var produto in ViewBag.Suprimentos) { <option value="@produto.Id" data-catalogo="@produto.PrecoCatalogo.ToString(CultureInfo.InvariantCulture)" data-preco-venda="@produto.PrecoCatalogo.ToString(CultureInfo.InvariantCulture)" data-estoque="@produto.Estoque.ToString(CultureInfo.InvariantCulture)">@produto.Nome</option> }
        </select></div>
        <div class="col-md-2"><label class="form-label">Quantidade</label><input type="number" min="0.001" step="0.001" class="form-control" data-campo="Quantidade" required /><div class="form-text estoque-disponivel" aria-live="polite"></div></div>
        <div class="col-md-2"><label class="form-label">Preço catélogo</label><input type="text" data-money-mask class="form-control bg-body-secondary text-muted" data-campo="PrecoCatalogo" readonly aria-readonly="true" required /></div>
        <div class="col-md-2"><label class="form-label">Preço de venda</label><input type="text" data-money-mask class="form-control bg-body-secondary text-muted" data-campo="PrecoUnitario" readonly aria-readonly="true" required /></div>
        <div class="col-md-2"><label class="form-label">Data</label><input type="date" class="form-control" data-campo="Data" required /></div>
        <div class="col-md-2"><label class="form-label">Promocional</label><select class="form-select" data-campo="Promocional"><option value="false">Náo</option><option value="true">Sim</option></select></div>
    </div></div></div></template>
@section Scripts {
<script>
(() => {
    const container = document.getElementById('itens');
    const template = document.getElementById('item-template');
    const moeda = n => new Intl.NumberFormat('pt-BR', {style:'currency', currency:'BRL'}).format(n);
    const numero = n => new Intl.NumberFormat('pt-BR', {maximumFractionDigits: 3}).format(n);
    const now = () => { const d = new Date(); return new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0,10); };
    function reindex() { container.querySelectorAll('.item-card').forEach((card, i) =>
        card.querySelectorAll('[data-campo]').forEach(el => el.name = `Itens[${i}].${el.dataset.campo}`)); }
    function calcular() {
        const subtotal = [...container.querySelectorAll('.item-card')].reduce((s, card) =>
            s + Number(card.querySelector('[data-campo="Quantidade"]').value) * window.VisoMoney.numero(card.querySelector('[data-campo="PrecoUnitario"]').value), 0);
        const desconto = window.VisoMoney.numero(document.getElementById('Desconto').value) || 0;
        const entrada = window.VisoMoney.numero(document.getElementById('ValorEntrada').value) || 0;
        const total = Math.max(0, subtotal - desconto);
        const saldo = Math.max(0, total - entrada);
        const n = Number(document.getElementById('NumeroParcelas').value) || 0;
        const cents = Math.round(saldo * 100);
        const base = n ? Math.floor(cents / n) : 0;
        const extra = n ? cents - base * n : 0;
        document.getElementById('resumo').textContent = `Total da venda: ${moeda(total)} | Saldo a receber: ${moeda(saldo)}` +
            (n ? ` em ${n} parcela(s)` : '');
        const previa = document.getElementById('parcelas-previa');
        const linhas = document.getElementById('parcelas-previa-linhas');
        linhas.replaceChildren();
        if (!n || saldo <= 0) { previa.hidden = true; return; }
        previa.hidden = false;
        const cliente = document.getElementById('ClienteId').selectedOptions[0]?.text || 'Selecione';
        const primeiro = document.getElementById('PrimeiroVencimento').value;
        for (let i = 0; i < n; i++) {
            let dataVencimento = '�';
            if (primeiro) {
                const [ano, mes, dia] = primeiro.split('-').map(Number);
                const mesAlvo = mes - 1 + i;
                const anoAlvo = ano + Math.floor(mesAlvo / 12);
                const indiceMes = mesAlvo % 12;
                const ultimoDia = new Date(anoAlvo, indiceMes + 1, 0).getDate();
                dataVencimento = new Date(anoAlvo, indiceMes, Math.min(dia, ultimoDia), 12).toLocaleDateString('pt-BR');
            }
            const valor = (base + (i < extra ? 1 : 0)) / 100;
            const tr = document.createElement('tr');
            const valores = [cliente, dataVencimento, moeda(valor), moeda(0), moeda(valor)];
            for (const conteudo of valores) {
                const td = document.createElement('td');
                td.textContent = conteudo;
                tr.appendChild(td);
            }
            linhas.appendChild(tr);
        }
    }
    function add(item = {}) {
        const card = template.content.firstElementChild.cloneNode(true);
        container.appendChild(card);
        for (const field of ['SuprimentoId','Quantidade','PrecoCatalogo','PrecoUnitario','Promocional']) {
            const element = card.querySelector(`[data-campo="${field}"]`);
            const valor = item[field] ?? (field === 'Quantidade' ? 1 : field === 'Promocional' ? 'false' : '');
            element.value = element.matches('[data-money-mask]')
                ? window.VisoMoney.formatarValorServidor(valor)
                : valor;
        }
        card.querySelector('[data-campo="Data"]').value = item.Data ? item.Data.slice(0,10) : now();
        const atualizarEstoque = option => {
            card.querySelector('.estoque-disponivel').textContent = option?.value
                ? `Disponível no estoque: ${numero(Number(option.dataset.estoque || 0))}`
                : '';
        };
        card.querySelector('.produto').addEventListener('change', e => {
            const option = e.target.selectedOptions[0];
            const precoCatalogo = card.querySelector('[data-campo="PrecoCatalogo"]');
            const precoVenda = card.querySelector('[data-campo="PrecoUnitario"]');
            precoCatalogo.value = window.VisoMoney.formatarValorServidor(option?.dataset.catalogo || 0);
            precoVenda.value = window.VisoMoney.formatarValorServidor(option?.dataset.precoVenda || 0);
            atualizarEstoque(option);
            calcular();
        });
        atualizarEstoque(card.querySelector('.produto').selectedOptions[0]);
        card.addEventListener('input', calcular);
        card.querySelector('.remover').addEventListener('click', () => { card.remove(); reindex(); calcular(); });
        reindex(); calcular();
    }
    document.getElementById('adicionar').addEventListener('click', () => add());
    for (const id of ['Desconto','ValorEntrada','NumeroParcelas']) document.getElementById(id).addEventListener('input', calcular);
    for (const id of ['ClienteId','PrimeiroVencimento']) document.getElementById(id).addEventListener('change', calcular);
    const initial = @Html.Raw(JsonSerializer.Serialize(Model.Itens));
    initial.forEach(add); calcular();
})();
</script>
}
