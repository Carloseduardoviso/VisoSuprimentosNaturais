# Copy this file to /opt/visoerp/shared/.env on the VPS and set mode 0600.
# Never commit the resulting .env file.

MSSQL_SA_PASSWORD=replace-with-a-strong-sql-sa-password
APP_DB_PASSWORD=replace-with-a-strong-app-sql-password
APP_CONNECTION_STRING=Server=db,1433;Database=VisoERP;User Id=visoerp_app;Password=replace-with-the-app-sql-password;Encrypt=True;TrustServerCertificate=True
MIGRATION_CONNECTION_STRING=Server=db,1433;Database=VisoERP;User Id=sa;Password=replace-with-the-sql-sa-password;Encrypt=True;TrustServerCertificate=True
AUTOMAPPER_LICENSE_KEY=replace-with-your-automapper-license-key
USER_REGISTRATION_KEY=replace-with-a-long-random-registration-key
FORWARDED_PROXY_IP=172.30.0.1
BACKUP_DIRECTORY=/srv/visoerp/backups

# Set only for the first successful application startup, then remove both values.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Used only by the host Caddy service, not by Docker Compose.
CADDY_EMAIL=replace-with-a-monitored-email-address
